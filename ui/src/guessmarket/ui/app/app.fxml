<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    The whole window.

    The top of it never changes: the cog that opens the settings, the name of the program, the
    button that loads a file, the path of the file that is currently loaded, and the bar that fills
    up while one is being read. The rest of the window is the two screens, each of which is a
    component of its own with its own layout file and its own controller.

    Nothing in the header is a preference. The colours the window is wearing, the size of its
    writing, whether it moves when something happens and what to do with the system as a whole are
    all decisions about the program rather than about a market, and all of them are behind the cog.
    What is left standing in the header is the one thing the program cannot begin without: a file.

    The settings sheet is the second half of the stack rather than a window of its own, so that it
    covers the header as well as the screens, and so that it is dressed by the same stylesheets as
    everything under it without being handed them.
-->
<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="guessmarket.ui.app.AppController">

    <BorderPane>

        <top>
            <VBox styleClass="header-bar" spacing="10">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button fx:id="settingsButton" styleClass="icon-button"
                            onAction="#onOpenSettings"/>
                    <Label text="Guess Market" styleClass="app-title"/>
                    <Label fx:id="subtitleLabel" styleClass="faint"
                           text="Prediction market - LMSR and Order Book"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="loadFileButton" text="Load File"
                            styleClass="button-primary" onAction="#onLoadFile"/>
                    <TextField fx:id="loadedFilePath" editable="false" focusTraversable="false"
                               promptText="No file has been loaded yet" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox fx:id="progressRow" alignment="CENTER_LEFT" spacing="10" managed="false"
                      visible="false">
                    <ProgressBar fx:id="loadProgressBar" prefWidth="260" progress="0"/>
                    <Label fx:id="loadProgressPercent" styleClass="value"/>
                    <Label fx:id="loadMessageLabel" styleClass="muted"/>
                </HBox>

            </VBox>
        </top>

        <center>
            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="Events">
                        <fx:include fx:id="eventsSection"
                                    source="/guessmarket/ui/events/events-section.fxml"/>
                    </Tab>
                    <Tab text="Users">
                        <fx:include fx:id="usersSection"
                                    source="/guessmarket/ui/users/users-section.fxml"/>
                    </Tab>
                </tabs>
            </TabPane>
        </center>

    </BorderPane>

    <fx:include fx:id="settingsPanel" source="/guessmarket/ui/settings/settings-panel.fxml"/>

</StackPane>
