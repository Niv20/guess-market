<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    The users screen, and the only place in the program where anything can be changed.

    On the left, everybody in the system. On the right, whoever is selected: their account, the
    events they run or take part in, and then, for whichever event they pick, what they have going
    on in it, what they may do about it, and the same event details the events screen shows.

    An action always belongs to somebody, which is why it happens here: the person acting is the one
    selected on the left, and there is never any doubt about whose money is moving.

    Both lists of this screen are tiles rather than tables, so that they keep everything they have
    to say however narrow the window is made: a name and a balance for a user, and for an event how
    it is doing, whose it is and what this user is to it. The users are a column down the left,
    because that list is the screen; the events are a strip read across, because everything worth
    choosing an event for is on the screen underneath them.

    The panel on the right is three groups of cards and is ruled off as three. The person comes
    first - who they are, what their account holds and how it has moved; then the events they are
    in, which is the list the rest of the panel is chosen from; then everything about the one event
    they have chosen. Every card in a group is about the same thing as the cards beside it, and
    without the rules a reader coming down the panel has nothing but a repeated gap to tell the end
    of one subject from the start of the next. The lines stop well short of both edges: a rule the
    full width of the panel is a border and reads as the top of whatever is underneath it.

    The list of people carries no title of its own. The tab above already says which screen this
    is, and a word repeating it cost the panel a row and gave nothing back; the titles that are
    left on this screen are inside the panel on the right, where each one names a card and no tab
    has said it already.

    How many people are in the system is said at the foot of the list of them, under a line the
    width of that list. The count is about the users on the left and about nothing else, so the
    rule stops where the list stops rather than carrying on under the panel beside it.
-->
<SplitPane fx:id="rootPane" dividerPositions="0.30"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="guessmarket.ui.users.UsersSectionController">

    <items>

        <VBox spacing="10" minWidth="210">
            <padding>
                <javafx.geometry.Insets top="14" right="10" bottom="14" left="14"/>
            </padding>
            <ListView fx:id="usersList" styleClass="tile-list"
                      VBox.vgrow="ALWAYS" minHeight="150"/>

            <HBox styleClass="panel-footer" alignment="CENTER_LEFT">
                <Label fx:id="userCountLabel" styleClass="faint"/>
            </HBox>
        </VBox>

        <ScrollPane fx:id="detailsScroll" fitToWidth="true" fitToHeight="true" minWidth="360">
            <!--
                The panel keeps the height its contents ask for, never the height of the window.
                Fitting to height is here so that a nearly empty panel still fills the viewport
                and the placeholder can sit in the middle of it; left to itself it also squeezes
                a panel taller than the window down to its minimum, and the minimum of a wrapped
                sentence is one line ending in dots. Asking for the preferred height as a minimum
                keeps the stretching and drops the squeezing.
            -->
            <StackPane minHeight="-Infinity">
                <padding>
                    <javafx.geometry.Insets top="14" right="14" bottom="14" left="10"/>
                </padding>

                <Label fx:id="placeholderLabel" styleClass="placeholder-text" wrapText="true"
                       StackPane.alignment="CENTER" textAlignment="CENTER"
                       text="Load a system details file to see the users."/>

                <VBox fx:id="detailsBox" spacing="12" managed="false" visible="false"
                      StackPane.alignment="TOP_LEFT">

                    <!--
                        Who this user is, and the money that decides what they may do next.

                        Three tiers, and no more than three. The name says whose panel this is;
                        the band under it holds the account, which is the figure every action on
                        this screen is measured against, and beside it what they have made or
                        lost so far; and the counts at the foot are true but are not what
                        anybody opened the panel for. What they started with is not a fourth
                        figure at all, it is the line the balance is read against, so it sits
                        under the balance as its caption rather than in a box of its own.
                    -->
                    <VBox styleClass="card" spacing="12">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="userNameLabel" styleClass="screen-title" text="User"/>
                            <Label fx:id="blockedBadge" styleClass="badge, badge-closed"
                                   text="BLOCKED" managed="false" visible="false"/>
                        </HBox>

                        <!-- the account, and the one figure that explains how it got there -->
                        <FlowPane styleClass="stat-band" hgap="44" vgap="14"
                                  rowValignment="TOP">
                            <VBox spacing="1">
                                <Label text="ACCOUNT BALANCE" styleClass="field-label"/>
                                <Label fx:id="balanceLabel"
                                       styleClass="value, value-hero, value-accent" text="—"/>
                                <Label fx:id="initialBalanceLabel" styleClass="caption"/>
                            </VBox>
                            <VBox spacing="1">
                                <Label text="MADE OR LOST" styleClass="field-label"/>
                                <Label fx:id="netResultLabel" styleClass="value, value-strong"/>
                            </VBox>
                        </FlowPane>

                        <!-- what they are doing in the system: a count, and not money -->
                        <HBox styleClass="meta-strip" alignment="CENTER_LEFT" spacing="8">
                            <Label text="RUNS" styleClass="field-label"/>
                            <Label fx:id="runsLabel" styleClass="inline-value"/>
                            <Label text="·" styleClass="faint"/>
                            <Label text="TAKING PART IN" styleClass="field-label"/>
                            <Label fx:id="participatesLabel" styleClass="inline-value"/>
                        </HBox>

                    </VBox>

                    <!-- how their balance has moved -->
                    <VBox fx:id="balanceChartBox" styleClass="card" spacing="8">
                        <Label text="ACCOUNT BALANCE PER ACTION" styleClass="panel-title"/>
                        <LineChart fx:id="balanceChart" prefHeight="210" minHeight="160"
                                   legendVisible="false" createSymbols="true" animated="false">
                            <xAxis>
                                <NumberAxis label="Action" minorTickCount="0" tickUnit="1"
                                            forceZeroInRange="true"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Balance" forceZeroInRange="false"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <Separator styleClass="section-rule"/>

                    <!--
                        The events they run or take part in, and everything else they may join.

                        A strip of cards read across rather than a column read down. Everything
                        under it — what this user has in the chosen event, what they may do
                        about it, and the event itself — is the reason the panel is open, and a
                        column of events pushed all of it below the fold. Laid on its side the
                        list takes one card's height however many events are loaded, and the
                        ones that do not fit are one scroll to the right instead of half a
                        screen further down.

                        Its height is fixed rather than grown, because the cards are what has to
                        stay the same size, not the strip: see EventTile.compact for what a card
                        this size can carry. The orientation is set by Tiles.renderStrip, which
                        is also what gives every card its width.

                        The height is what a card of two lines needs when one of them wraps: a
                        name over three lines, or a name over two with the line under it wrapping
                        as well. That is the tallest a card actually gets now that the money has
                        come off the foot of it, and it is a third less than the strip used to
                        take. Fixing it any tighter would cut the last line off an event with a
                        long name, and any looser would be a row of cards with a band of nothing
                        along the bottom of every one of them.
                    -->
                    <VBox styleClass="card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="EVENTS" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ToggleButton fx:id="allEventsButton" text="All events"
                                          selected="true"/>
                            <ToggleButton fx:id="myEventsButton" text="Only mine"/>
                        </HBox>
                        <ListView fx:id="eventsList" styleClass="tile-list, tile-strip"
                                  prefHeight="104" minHeight="104" maxHeight="104"/>
                    </VBox>

                    <!--
                        Everything below is about one event rather than about the person, so the
                        rule appears with it and goes when nothing is chosen: a line with nothing
                        under it says a panel failed to load rather than that a group has ended.
                    -->
                    <Separator fx:id="chosenEventRule" styleClass="section-rule"
                               managed="false" visible="false"/>

                    <fx:include fx:id="userInvolvement" source="user-involvement.fxml"/>
                    <fx:include fx:id="tradePanel"
                                source="/guessmarket/ui/trade/trade-panel.fxml"/>
                    <fx:include fx:id="eventDetails"
                                source="/guessmarket/ui/events/event-details.fxml"/>

                </VBox>
            </StackPane>
        </ScrollPane>

    </items>
</SplitPane>
