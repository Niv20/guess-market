<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    The users screen, and the only place in the program where anything can be changed.

    On the left, everybody in the system. On the right, whoever is selected: their account, the
    events they run or take part in, and then, for whichever event they pick, what they have going
    on in it, what they may do about it, and the same event details the events screen shows.

    An action always belongs to somebody, which is why it happens here: the person acting is the one
    selected on the left, and there is never any doubt about whose money is moving.

    Both lists of this screen are columns of tiles rather than tables, so that they keep everything
    they have to say however narrow the window is made: a name and a balance for a user, and for an
    event how it is doing, whose it is and what this user is to it.
-->
<SplitPane fx:id="rootPane" dividerPositions="0.30"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="guessmarket.ui.users.UsersSectionController">

    <items>

        <VBox spacing="10" minWidth="210">
            <padding>
                <javafx.geometry.Insets top="14" right="10" bottom="14" left="14"/>
            </padding>
            <Label text="USERS" styleClass="panel-title"/>
            <ListView fx:id="usersList" styleClass="tile-list"
                      VBox.vgrow="ALWAYS" minHeight="150"/>
            <Label fx:id="userCountLabel" styleClass="faint"/>
        </VBox>

        <ScrollPane fx:id="detailsScroll" fitToWidth="true" minWidth="360">
            <StackPane>
                <padding>
                    <javafx.geometry.Insets top="14" right="14" bottom="14" left="10"/>
                </padding>

                <Label fx:id="placeholderLabel" styleClass="placeholder-text" wrapText="true"
                       text="Load a system details file to see the users."/>

                <VBox fx:id="detailsBox" spacing="12" managed="false" visible="false">

                    <!--
                        Who this user is, and the money that decides what they may do next.

                        Three tiers, and no more than three. The name says whose panel this is;
                        the band under it holds the account, which is the figure every action on
                        this screen is measured against, and beside it what they have made or lost
                        so far; and the counts at the foot are true but are not what anybody opened
                        the panel for. What they started with is not a fourth figure at all, it is
                        the line the balance is read against, so it sits under the balance as its
                        caption rather than in a box of its own.
                    -->
                    <VBox styleClass="card" spacing="12">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="userNameLabel" styleClass="screen-title" text="User"/>
                            <Label fx:id="blockedBadge" styleClass="badge, badge-closed"
                                   text="BLOCKED" managed="false" visible="false"/>
                        </HBox>

                        <!-- the account, and the one figure that explains how it got there -->
                        <FlowPane styleClass="stat-band" hgap="44" vgap="14" rowValignment="TOP">
                            <VBox spacing="1">
                                <Label text="ACCOUNT BALANCE" styleClass="field-label"/>
                                <Label fx:id="balanceLabel"
                                       styleClass="value, value-hero, value-accent" text="—"/>
                                <Label fx:id="initialBalanceLabel" styleClass="caption"/>
                            </VBox>
                            <VBox spacing="1">
                                <Label text="MADE OR LOST" styleClass="field-label"/>
                                <Label fx:id="netResultLabel" styleClass="value, value-strong"/>
                            </VBox>
                        </FlowPane>

                        <!-- what they are doing in the system, which is a count and not money -->
                        <HBox styleClass="meta-strip" alignment="CENTER_LEFT" spacing="8">
                            <Label text="RUNS" styleClass="field-label"/>
                            <Label fx:id="runsLabel" styleClass="inline-value"/>
                            <Label text="·" styleClass="faint"/>
                            <Label text="TAKING PART IN" styleClass="field-label"/>
                            <Label fx:id="participatesLabel" styleClass="inline-value"/>
                        </HBox>

                    </VBox>

                    <!-- how their balance has moved -->
                    <VBox fx:id="balanceChartBox" styleClass="card" spacing="8">
                        <Label text="ACCOUNT BALANCE PER ACTION" styleClass="panel-title"/>
                        <LineChart fx:id="balanceChart" prefHeight="210" minHeight="160"
                                   legendVisible="false" createSymbols="true" animated="false">
                            <xAxis>
                                <NumberAxis label="Action" minorTickCount="0" tickUnit="1"
                                            forceZeroInRange="true"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Balance" forceZeroInRange="false"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- the events they run or take part in, and everything else they may join -->
                    <VBox styleClass="card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="EVENTS" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ToggleButton fx:id="allEventsButton" text="All events" selected="true"/>
                            <ToggleButton fx:id="myEventsButton" text="Only mine"/>
                        </HBox>
                        <ListView fx:id="eventsList" styleClass="tile-list"
                                  prefHeight="300" minHeight="150"/>
                    </VBox>

                    <fx:include fx:id="userInvolvement" source="user-involvement.fxml"/>
                    <fx:include fx:id="tradePanel"
                                source="/guessmarket/ui/trade/trade-panel.fxml"/>
                    <fx:include fx:id="eventDetails"
                                source="/guessmarket/ui/events/event-details.fxml"/>

                </VBox>
            </StackPane>
        </ScrollPane>

    </items>
</SplitPane>
