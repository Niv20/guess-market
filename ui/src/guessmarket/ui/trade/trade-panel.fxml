<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    What the selected user may do in the selected event, on two cards rather than one.

    They are two because they are two different kinds of thing. Management is what is done to the
    event: opening it, which is what brings a market into being, and closing it, which decides the
    outcome and pays everybody out. Actions are what is done inside the event while it runs, which
    is trading. The first belongs to one person and happens twice in the life of an event; the
    second belongs to everybody and happens all day. Putting a button that ends the event in the
    same box as the field somebody types a number of shares into said they were alternatives, and
    they are not: they are the frame and the thing inside it.

    Each card is on the screen only when there is something to put on it, so a market maker with an
    event that has not opened sees Management alone, everybody else in a running event sees Actions
    alone, and the market maker of a running event sees both, in that order - what the event is
    waiting for them to decide, and then what everybody including them can do meanwhile.

    Neither card says who is acting. They are only ever on the screen underneath the person they
    act as - their name is the largest thing on the panel above, and every figure between the two
    belongs to them - so a line repeating it was a row spent saying what the screen had said
    already.

    Nothing on either card is squeezed. Every control keeps the width its own text needs and rows
    of them wrap onto a second line when the panel is dragged narrower, rather than each control
    giving up a little until the words inside them end in dots; and every sentence explaining an
    action is a paragraph above that row, the full width of the card, rather than a column beside
    a button with too little room to be read in.
-->
<VBox fx:id="rootPane" spacing="12"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="guessmarket.ui.trade.TradePanelController">

    <!-- what is done to the event, and only by the one person answerable for it -->
    <VBox fx:id="managementBox" styleClass="card" spacing="10" managed="false" visible="false">
        <Label text="MANAGEMENT" styleClass="panel-title"/>

        <!-- the market maker starts the event -->
        <VBox fx:id="openBox" spacing="8" managed="false" visible="false">
            <Label fx:id="openCostLabel" styleClass="muted" wrapText="true"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="openButton" text="Open the event" styleClass="button-primary"
                        minWidth="-Infinity" onAction="#onOpenEvent"/>
            </HBox>
        </VBox>

        <!-- the market maker decides the outcome -->
        <VBox fx:id="closeBox" spacing="8" managed="false" visible="false">
            <Label fx:id="closeHintLabel" styleClass="muted" wrapText="true"/>
            <FlowPane hgap="12" vgap="8" rowValignment="BOTTOM">
                <VBox spacing="2">
                    <Label text="WINNING OPTION" styleClass="field-label"/>
                    <ComboBox fx:id="winnerChooser" prefWidth="190" minWidth="-Infinity"/>
                </VBox>
                <Button fx:id="closeButton" text="Close the event" styleClass="button-danger"
                        minWidth="-Infinity" onAction="#onCloseEvent"/>
            </FlowPane>
        </VBox>
    </VBox>

    <!-- what is done inside the event while it runs, and by anybody -->
    <VBox fx:id="actionsBox" styleClass="card" spacing="10" managed="false" visible="false">
        <Label text="ACTIONS" styleClass="panel-title"/>

        <Label fx:id="messageLabel" styleClass="muted" wrapText="true"
               managed="false" visible="false"/>

        <!-- LMSR: buy shares from the event itself -->
        <VBox fx:id="buyBox" spacing="8" managed="false" visible="false">
            <FlowPane hgap="12" vgap="8" rowValignment="BOTTOM">
                <VBox spacing="2">
                    <Label text="OPTION" styleClass="field-label"/>
                    <ComboBox fx:id="buyOptionChooser" prefWidth="190" minWidth="-Infinity"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="SHARES" styleClass="field-label"/>
                    <TextField fx:id="sharesField" prefWidth="110" minWidth="-Infinity"
                               promptText="whole number"/>
                </VBox>
                <Button fx:id="buyButton" text="Buy shares" styleClass="button-primary"
                        minWidth="-Infinity" onAction="#onBuyShares"/>
            </FlowPane>
            <Label fx:id="quoteLabel" styleClass="muted" wrapText="true"/>
        </VBox>

        <!-- order book: place an order and let the market do what it can with it -->
        <VBox fx:id="orderBox" spacing="8" managed="false" visible="false">
            <FlowPane hgap="12" vgap="8" rowValignment="BOTTOM">
                <VBox spacing="2">
                    <Label text="OPTION" styleClass="field-label"/>
                    <ComboBox fx:id="orderOptionChooser" prefWidth="170" minWidth="-Infinity"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="ACTION" styleClass="field-label"/>
                    <ComboBox fx:id="sideChooser" prefWidth="110" minWidth="-Infinity"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="SHARES" styleClass="field-label"/>
                    <TextField fx:id="quantityField" prefWidth="100" minWidth="-Infinity"
                               promptText="whole number"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="PRICE PER SHARE" styleClass="field-label"/>
                    <TextField fx:id="priceField" prefWidth="120" minWidth="-Infinity"
                               promptText="0.01 - 0.99"/>
                </VBox>
                <Button fx:id="submitOrderButton" text="Place the order"
                        styleClass="button-primary" minWidth="-Infinity"
                        onAction="#onSubmitOrder"/>
            </FlowPane>
            <Label fx:id="orderHintLabel" styleClass="muted" wrapText="true"/>
        </VBox>
    </VBox>

</VBox>
