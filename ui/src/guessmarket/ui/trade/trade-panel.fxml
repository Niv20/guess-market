<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    What the selected user may do in the selected event.

    Only one of the rows below is ever shown at a time, chosen by who the user is and what stage
    the event is at: the market maker opens an event and later closes it, and everybody else trades
    in it while it is running. An LMSR event is traded by buying shares from the event itself; an
    order book event is traded by placing an order in one of its books.
-->
<VBox fx:id="rootPane" styleClass="card" spacing="10"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="guessmarket.ui.trade.TradePanelController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="ACTIONS" styleClass="panel-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="actingAsLabel" styleClass="faint"/>
    </HBox>

    <Label fx:id="messageLabel" styleClass="muted" wrapText="true" managed="false" visible="false"/>

    <!-- the market maker starts the event -->
    <HBox fx:id="openBox" spacing="12" alignment="CENTER_LEFT" managed="false" visible="false">
        <Button fx:id="openButton" text="Open the event" styleClass="button-primary"
                onAction="#onOpenEvent"/>
        <Label fx:id="openCostLabel" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- LMSR: buy shares from the event itself -->
    <VBox fx:id="buyBox" spacing="8" managed="false" visible="false">
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="2">
                <Label text="OPTION" styleClass="field-label"/>
                <ComboBox fx:id="buyOptionChooser" prefWidth="190"/>
            </VBox>
            <VBox spacing="2">
                <Label text="SHARES" styleClass="field-label"/>
                <TextField fx:id="sharesField" prefWidth="110" promptText="whole number"/>
            </VBox>
            <Button fx:id="buyButton" text="Buy shares" styleClass="button-primary"
                    onAction="#onBuyShares"/>
        </HBox>
        <Label fx:id="quoteLabel" styleClass="muted" wrapText="true"/>
    </VBox>

    <!-- order book: place an order and let the market do what it can with it -->
    <VBox fx:id="orderBox" spacing="8" managed="false" visible="false">
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="2">
                <Label text="OPTION" styleClass="field-label"/>
                <ComboBox fx:id="orderOptionChooser" prefWidth="170"/>
            </VBox>
            <VBox spacing="2">
                <Label text="ACTION" styleClass="field-label"/>
                <ComboBox fx:id="sideChooser" prefWidth="110"/>
            </VBox>
            <VBox spacing="2">
                <Label text="SHARES" styleClass="field-label"/>
                <TextField fx:id="quantityField" prefWidth="100" promptText="whole number"/>
            </VBox>
            <VBox spacing="2">
                <Label text="PRICE PER SHARE" styleClass="field-label"/>
                <TextField fx:id="priceField" prefWidth="120" promptText="0.01 - 0.99"/>
            </VBox>
            <Button fx:id="submitOrderButton" text="Place the order" styleClass="button-primary"
                    onAction="#onSubmitOrder"/>
        </HBox>
        <Label fx:id="orderHintLabel" styleClass="muted" wrapText="true"/>
    </VBox>

    <!-- the market maker decides the outcome -->
    <HBox fx:id="closeBox" spacing="12" alignment="BOTTOM_LEFT" managed="false" visible="false">
        <VBox spacing="2">
            <Label text="WINNING OPTION" styleClass="field-label"/>
            <ComboBox fx:id="winnerChooser" prefWidth="190"/>
        </VBox>
        <Button fx:id="closeButton" text="Close the event" styleClass="button-danger"
                onAction="#onCloseEvent"/>
        <Label fx:id="closeHintLabel" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>
