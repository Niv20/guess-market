<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Everything there is to see about one event, and nothing that acts on it.

    The same component is used by both screens. The events screen shows it on its own, as an
    overview; the users screen shows it underneath the controls of whichever user is selected, so
    that the effect of an action appears in the same picture the rest of the system sees.

    An event is traded either by LMSR or through an order book, and the two halves below are shown
    one at a time accordingly: LMSR has an option value, an order book has two books.
-->
<VBox fx:id="rootPane" spacing="12"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="guessmarket.ui.events.EventDetailsController">

    <!--
        What the event is, and everything the file settled about it, in three tiers.

        The header used to be nine identical boxes, which is nine things of equal weight and so no
        weight at all. They are told apart here by what they are, not by what they say:

        the name, the state, the question, and under it how it is traded and whose it is - all of
            which is what the event IS, and is read first and as one thing;
        the account and the commission earned MOVE, every time somebody trades;
        and the terms were settled when the event was made and will never change again.

        The last group is the biggest and the quietest, because it is read once and then only
        referred back to. The two figures that move are the only ones given any size at all.
    -->
    <VBox styleClass="card" spacing="12">

        <!-- what the event is -->
        <VBox spacing="6">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="eventNameLabel" styleClass="screen-title" text="Event"/>
                <Label fx:id="statusBadge" styleClass="badge" text="Status"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="winnerBadge" styleClass="badge, badge-winner" managed="false"
                       visible="false" text="Winner"/>
            </HBox>
            <Label fx:id="descriptionLabel" styleClass="lead" wrapText="true" text=""/>

            <!--
                How the event is traded and whose it is, on one pill directly under the question.

                Those two things are what frames the question above them: they say which half of
                everything further down the screen applies, and who is answerable for all of it.
                They were a row of their own further down, with the runner named on the left and
                the method held out on the right, which is two facts about the same event put as
                far apart as the row would allow and read as two.

                Said together and set immediately under the description, they finish the sentence
                the description started - this is the question, this is how it is traded and this
                is whose it is - and the reader has the whole of the event before the first figure
                on the card. It is also still the one thing in this header that can be pressed:
                pressing it goes to the part of the screen that does the trading it names.
            -->
            <HBox alignment="CENTER_LEFT">
                <Button fx:id="methodButton" styleClass="method-link" text="Method"
                        minWidth="-Infinity" onAction="#onShowMarket"/>
            </HBox>
        </VBox>

        <!-- the two figures that move while people trade -->
        <FlowPane styleClass="stat-band" hgap="44" vgap="14" rowValignment="TOP">
            <VBox spacing="1">
                <Label text="EVENT ACCOUNT" styleClass="field-label"/>
                <Label fx:id="accountBalanceLabel"
                       styleClass="value, value-hero, value-accent" text="—"/>
                <Label text="held by the event itself" styleClass="caption"/>
            </VBox>
            <VBox spacing="1">
                <Label text="COMMISSION EARNED" styleClass="field-label"/>
                <Label fx:id="commissionCollectedLabel" styleClass="value, value-strong"/>
                <Label text="to the market maker so far" styleClass="caption"/>
            </VBox>
        </FlowPane>

        <!--
            The terms it was opened on, which were settled once and never change.

            Equal boxes in one row, because these are the same kind of fact as each other and
            there is nothing to choose between them: whichever one is being looked for, it is
            being looked for by name. The row is filled by however many the trading method calls
            for - four for an order book, three for LMSR - and the controller sizes the columns to
            match, so the row is always full and never ends in a gap. Each figure is centred under
            its own name, with whatever qualifies it in small print underneath, which is what lets
            boxes of different contents still look like one row.
        -->
        <VBox spacing="8">
            <Label text="TERMS" styleClass="group-title"/>
            <GridPane fx:id="termsGrid" hgap="10" vgap="10">
                <VBox fx:id="commissionTile" styleClass="stat-tile" alignment="CENTER" spacing="1"
                      maxWidth="Infinity">
                    <Label text="COMMISSION" styleClass="field-label"/>
                    <Label fx:id="commissionLabel" styleClass="value"/>
                    <Label fx:id="commissionWhenLabel" styleClass="caption"/>
                </VBox>
                <VBox fx:id="liquidityTile" styleClass="stat-tile" alignment="CENTER" spacing="1"
                      maxWidth="Infinity">
                    <Label text="LIQUIDITY b" styleClass="field-label"/>
                    <Label fx:id="liquidityLabel" styleClass="value"/>
                </VBox>
                <VBox fx:id="subsidyTile" styleClass="stat-tile" alignment="CENTER" spacing="1"
                      maxWidth="Infinity">
                    <Label text="SUBSIDY" styleClass="field-label"/>
                    <Label fx:id="subsidyLabel" styleClass="value"/>
                    <Label fx:id="subsidyPaidLabel" styleClass="caption"/>
                </VBox>
                <VBox fx:id="baseValueTile" styleClass="stat-tile" alignment="CENTER" spacing="1"
                      maxWidth="Infinity">
                    <Label text="BASE VALUE d" styleClass="field-label"/>
                    <Label fx:id="baseValueLabel" styleClass="value"/>
                    <Label text="per pair" styleClass="caption"/>
                </VBox>
                <VBox fx:id="investmentTile" styleClass="stat-tile" alignment="CENTER" spacing="1"
                      maxWidth="Infinity">
                    <Label text="OPENING INVESTMENT" styleClass="field-label"/>
                    <Label fx:id="investmentLabel" styleClass="value"/>
                    <Label fx:id="investmentPairsLabel" styleClass="caption"/>
                </VBox>
                <VBox fx:id="mintTile" styleClass="stat-tile" alignment="CENTER" spacing="1"
                      maxWidth="Infinity">
                    <Label text="MINTING" styleClass="field-label"/>
                    <Label fx:id="mintLabel" styleClass="value"/>
                </VBox>
            </GridPane>
        </VBox>

    </VBox>

    <!--
        An event that has not been opened yet.

        Everything below this is a market: what the options are worth, who is in it, what has been
        traded and at what price. None of that exists before the market maker has paid to open the
        event - the tables would be empty, the values would be the values nobody has yet been able
        to trade at, and a screen of empty panels reads as a system that has lost the data rather
        than as an event that has not begun. So they are all taken away and this stands in their
        place, saying the one thing there is to say and naming the one person who can change it.

        What stays above is the event itself and the terms it will open on, which are settled and
        are exactly what somebody looking at an unopened event has come to read.
    -->
    <VBox fx:id="waitingBox" styleClass="card" managed="false" visible="false">
        <Label fx:id="waitingLabel" styleClass="lead" wrapText="true" text=""/>
    </VBox>

    <!-- LMSR: what each option is worth, and how many of its shares have been bought -->
    <VBox fx:id="lmsrBox" styleClass="card" spacing="8">
        <Label text="OPTIONS" styleClass="panel-title"/>
        <TableView fx:id="optionsTable"/>
    </VBox>

    <!-- Order book: one book per option, side by side -->
    <VBox fx:id="booksBox" styleClass="card" spacing="8">
        <Label text="ORDER BOOK" styleClass="panel-title"/>
        <HBox spacing="12">
            <fx:include fx:id="firstBook" source="option-book.fxml" HBox.hgrow="ALWAYS"/>
            <fx:include fx:id="secondBook" source="option-book.fxml" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <!-- who is in the event and what they hold -->
    <VBox fx:id="participantsBox" styleClass="card" spacing="8">
        <Label text="PARTICIPANTS" styleClass="panel-title"/>
        <TableView fx:id="participantsTable"/>
    </VBox>

    <!-- everything that has happened, newest first -->
    <VBox fx:id="historyBox" styleClass="card" spacing="8">
        <Label text="TRADING HISTORY" styleClass="panel-title"/>
        <TableView fx:id="historyTable"/>
    </VBox>

    <!-- how the price of each option has moved -->
    <VBox fx:id="chartBox" styleClass="card" spacing="8">
        <Label text="PRICE PER TRANSACTION" styleClass="panel-title"/>
        <LineChart fx:id="priceChart" prefHeight="230" minHeight="180" legendSide="BOTTOM"
                   createSymbols="true" animated="false">
            <xAxis>
                <NumberAxis fx:id="tradeAxis" label="Transaction" minorTickCount="0"
                            tickUnit="1" forceZeroInRange="true"/>
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="priceAxis" label="Price" forceZeroInRange="true"/>
            </yAxis>
        </LineChart>
    </VBox>

</VBox>
