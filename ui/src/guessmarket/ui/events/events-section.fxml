<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    The events screen.

    On the left, every event in the system with a row of filter dropdowns above it; on the right,
    whichever one is selected, shown by the event details component. The divider can be dragged, and
    the details side scrolls, so the screen stays usable when the window is made small.

    The list on the left is a column of tiles rather than a table, so that it keeps its whole
    contents however narrow it is dragged: a table of seven columns has a width below which it can
    only start hiding things, and this list has none.

    Neither of the two screens puts its own name at the top of it. The tab above already says
    which screen this is, and a word repeating it cost the panel a row and gave nothing back.

    The one action of this screen is the last row of the list rather than a button standing
    somewhere beside it. Creating an event adds a row to that list, so it is offered at the end of
    it, where what it makes will appear, and it travels with the events as they are scrolled
    instead of waiting at a fixed edge of the panel. Until a file is loaded there is no list for it
    to end and it is not on the screen at all, which is why it is built by the controller and there
    is no button to be found in this file.

    How much of the system is on the screen is said at the foot of the list that is showing it,
    under a line the width of that list. The count is about the events on the left and about
    nothing else, so the rule stops where the list stops rather than carrying on under the details
    beside it.
-->
<SplitPane fx:id="rootPane" dividerPositions="0.44"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="guessmarket.ui.events.EventsSectionController">

    <items>

        <VBox spacing="10" minWidth="220">
            <padding>
                <javafx.geometry.Insets top="14" right="10" bottom="14" left="14"/>
            </padding>

            <FlowPane styleClass="filter-bar" hgap="14" vgap="8">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="TYPE" styleClass="field-label"/>
                    <ComboBox fx:id="typeChooser" prefWidth="108"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="STATUS" styleClass="field-label"/>
                    <ComboBox fx:id="statusChooser" prefWidth="108"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="COMMISSION" styleClass="field-label"/>
                    <ComboBox fx:id="commissionChooser" prefWidth="112"/>
                </HBox>
            </FlowPane>

            <ListView fx:id="eventsList" styleClass="tile-list"
                      VBox.vgrow="ALWAYS" minHeight="150"/>

            <HBox styleClass="panel-footer" alignment="CENTER_LEFT">
                <Label fx:id="countLabel" styleClass="faint"/>
            </HBox>
        </VBox>

        <ScrollPane fx:id="detailsScroll" fitToWidth="true" fitToHeight="true" minWidth="320">
            <StackPane>
                <padding>
                    <javafx.geometry.Insets top="14" right="14" bottom="14" left="10"/>
                </padding>
                <Label fx:id="placeholderLabel" styleClass="placeholder-text" wrapText="true"
                       StackPane.alignment="CENTER" textAlignment="CENTER"
                       text="Load a system details file to see the events."/>
                <fx:include fx:id="eventDetails" source="event-details.fxml"
                            StackPane.alignment="TOP_LEFT"/>
            </StackPane>
        </ScrollPane>

    </items>
</SplitPane>
